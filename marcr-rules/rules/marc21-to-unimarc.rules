# Title: nonfiling characters (indicator 2) between NSB and NSE; a $b
# after a $a ending with "=" is a parallel title. Statements of
# responsibility after the first (" ; ") go to $g.
245 when !$a~=$ -> 200 [1#] {
  $a -> $a "{@ind2}{}" | replace('^1(.)', '\u{98}$1\u{9c}') | replace('^2(.{2})', '\u{98}$1\u{9c}') | replace('^3(.{3})', '\u{98}$1\u{9c}') | replace('^4(.{4})', '\u{98}$1\u{9c}') | replace('^5(.{5})', '\u{98}$1\u{9c}') | replace('^6(.{6})', '\u{98}$1\u{9c}') | replace('^7(.{7})', '\u{98}$1\u{9c}') | replace('^8(.{8})', '\u{98}$1\u{9c}') | replace('^9(.{9})', '\u{98}$1\u{9c}') | replace('^[0-9]', '') | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $h -> $b | replace('[\[\]]', '') | replace(' *[/:;=,.]$', '')
  $b -> $e | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $n -> $h | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $p -> $i | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $f -> $e | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $g -> $e | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $k -> $e | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $c -> $f | replace(' ; .*$', '') | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1'), $g | replace('^[^;]*$', '') | replace('^[^;]*; *', '') | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
}
245 when $a~=$ -> 200 [1#] {
  $a -> $a "{@ind2}{}" | replace('^1(.)', '\u{98}$1\u{9c}') | replace('^2(.{2})', '\u{98}$1\u{9c}') | replace('^3(.{3})', '\u{98}$1\u{9c}') | replace('^4(.{4})', '\u{98}$1\u{9c}') | replace('^5(.{5})', '\u{98}$1\u{9c}') | replace('^6(.{6})', '\u{98}$1\u{9c}') | replace('^7(.{7})', '\u{98}$1\u{9c}') | replace('^8(.{8})', '\u{98}$1\u{9c}') | replace('^9(.{9})', '\u{98}$1\u{9c}') | replace('^[0-9]', '') | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $h -> $b | replace('[\[\]]', '') | replace(' *[/:;=,.]$', '')
  $b -> $d | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $n -> $h | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
