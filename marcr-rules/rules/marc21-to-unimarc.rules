  $g -> $n | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $s -> $q | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $m -> $r | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $r -> $u | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $o -> $w | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
}
