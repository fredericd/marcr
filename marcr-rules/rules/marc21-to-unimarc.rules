001 -> 001
005 -> 005

# ISBN: qualifier in parentheses after the number in older records
020 -> 010 [##] {
  $a -> $a | replace(' .*$', ''), $b | replace('^\S+ ?', '') | replace('^\((.*)\)[ :;]*$', '$1') | replace('[ :;]+$', '')
  $q -> $b | replace('^\((.*)\)$', '$1')
  $c -> $d | replace(' *[/:;=,]? *$', '')
  $z -> $z | replace(' .*$', '')
}

