# MARC21 to UNIMARC, written after the MARC 21 and UNIMARC Bibliographic
# (IFLA) formats, and checked on native MARC21 records of the Library of
# Congress (see corpus/ in the marcr-rules repository).
#
# MARC21 carries ISBD punctuation inside subfields; UNIMARC leaves it to
# display. Trailing " /", " :", " ;", " =", "," are removed, and a final
# period after a word of four letters or more, a digit or a bracket: one
# after a shorter word is kept, as it may end an abbreviation ("ed.",
# "p.", "J."). That chain is written out in each rule:
#   replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
#
# Coded data follow the UNIMARC Bibliographic Format Manual (IFLA,
# online ed. 1.1.0, 2024). Not converted: 006 (but for 135/0), RDA
# fields without a UNIMARC equivalent (340, 344, 648), medium of
# performance (382: 146 needs IAML codes, not terms).

rules "MARC21 to UNIMARC"
version 0.1

# ---- Tables ---------------------------------------------------------

# Leader/05 record status
table status {
  a = c
}

# Leader/06 type of record
table type {
  m = l
  o = m
  p = m
  t = b
}

# Leader/07 bibliographic level
table level {
  b = a
  d = m
}

# Leader/17 encoding level (OCLC codes too)
table encoding {
  2 = 3
  4 = " "
  5 = 2
  7 = 3
  8 = 2
  I = " "
  J = 3
  K = 3
  L = 1
  M = " "
  u = " "
  z = " "
}

# 008/06 type of date -> 100/08 type of publication date
table datetype {
  b = u
  c = a
  d = b
  e = j
  i = g
  k = g
  m = g
  n = u
  p = i
  q = f
  r = e
  s = d
  t = h
  u = c
  "|" = u
}

# 008/07-14 unknown digits: blanks in UNIMARC
table unknown {
  u = " "
  "|" = " "
}

# 008/22 target audience (blank and fill already turned to u)
table audience {
  a = b
  b = c
  c = d
  d = e
  e = m
  f = k
  g = m
  j = a
}

# 008/28 government publication (blank already turned to y)
table government {
  a = z
  c = e
  f = a
  i = f
  l = d
  m = e
  o = h
  s = b
  "|" = u
}

# 008/18-21 (books) illustrations -> 105/0-3
table illustrations {
  o = a
  p = o
}

# 008/24-27 (books) nature of contents -> 105/4-7
table contents {
  a = d
  b = a
  c = b
  d = e
  e = f
  f = z
  g = z
  i = c
  j = k
  k = a
  l = n
  m = m
  n = r
  o = r
  p = j
  q = a
  r = g
  s = i
  t = p
  u = l
  v = n
  w = n
  y = z
  z = s
  2 = z
  5 = z
  6 = t
}

# 008/33 (books) literary form -> 105/11
table literature {
  0 = y
  1 = a
  c = z
  d = b
  e = c
  f = a
  h = d
  i = e
  j = f
  m = z
  p = g
  s = h
  u = z
}

# 008/23 form of item (blank already turned to r) -> 106
table itemform {
  a = t
  b = t
  c = t
  o = s
  q = s
}

# 008/21 (serials) type of continuing resource -> 110/0
table serialtype {
  d = f
  l = e
  m = b
  n = c
  p = a
  w = g
  " " = z
}

# 008/18 (serials) frequency (blank already turned to y) -> 110/1
table frequency {
  a = k
  b = g
  c = b
  d = a
  e = d
  f = j
  g = l
  h = m
  i = n
  j = o
  k = p
  m = f
  q = h
  s = e
  t = i
  w = c
}

# 008/19 (serials) regularity -> 110/2
table regularity {
  r = a
  n = b
  x = y
}

# 008/24-27 (serials) nature of contents -> 110/3-6
table serialcontents {
  a = d
  b = a
  c = b
  d = e
  e = f
  f = z
  g = n
  h = p
  i = c
  k = a
  l = l
  n = r
  o = k
  q = a
  r = g
  s = i
  t = z
  v = o
  w = m
  y = h
  z = z
  5 = z
  6 = t
}

