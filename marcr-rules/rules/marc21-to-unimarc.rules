# ---- Responsibility -------------------------------------------------

# Personal names: 100 primary responsibility (700); 700 alternative
# (701, authors and names without a relator) or secondary (702, other
# relators); families (indicator 1 = 3) to 720, 721, 722. A name with a
# title ($t) is a work, not converted here.
100 when !@ind1=3 -> 700 [#{@ind1}] {
  $a -> $a | replace(',.*$', '') | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1'), $b | replace('^[^,]*,? *', '') | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $b -> $d | replace(' *[/:;=,]? *$', '')
  $c -> $c | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $d -> $f | replace(' *[/:;=,]? *$', '') | replace('([\p{L}\p{M}]{4}|[0-9)\]])\.$', '$1')
  $q -> $g | replace('^\(', '') | replace('\),?$', '')
  $e -> $4 | lower | replace('[ .,]+$', '') | table(relators)
  $4 -> $4 | replace('^.*/', '') | table(relators)
  order $a $b $c $d $f $g $4
}
