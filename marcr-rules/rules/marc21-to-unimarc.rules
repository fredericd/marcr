# Cataloguing sources: original, transcribing and (last) modifying agency
040 -> 801 [#0] {
  -> $a "{$a|table(orgcountry)}"
  $a -> $b
  -> $c "{008/0-5|replace('^([0-2])', '20$1')|replace('^([3-9])', '19$1')}"
  -> $g "{LDR/18}{$e|exists('+', '')}" | replace('^a$', 'AACR2') | replace('^[^A].*$', '')
  $e -> $g | upper
  order $a $b $c $g
}
040 when $c -> 801 [#1] {
  -> $a "{$c|table(orgcountry)}"
  -> $b "{$c}"
}
040 when $d -> 801 [#2] {
  -> $a "{$d[-1]|table(orgcountry)}"
  -> $b "{$d[-1]}"
  -> $c "{005/0-7}"
  order $a $b $c
}

# Geographic area codes. shortcut: repeated $a stay in one 660, which
# UNIMARC does not repeat; one field per code needs a field per subfield.
043 -> 660 [##] { $a -> $a }

# Time period of content: MARC 21 codes (045 $a) are those of 661;
# formatted dates (045 $b) those of 122. shortcut: repeated $a stay in
# one 661, as for 660.
045 when $a -> 661 [##] { $a -> $a }
045 when $b -> 122 [{@ind1}#] { $b -> $a }

# Digital file characteristics
347 -> 231 [##] {
  $a -> $a
  $b -> $b
  $c -> $e
  $d -> $f
  $e -> $g
  $f -> $h
  $2 -> $2
}

# ---- Classification -------------------------------------------------

050 -> 680 [##] {
