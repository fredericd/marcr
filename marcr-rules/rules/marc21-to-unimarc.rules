# ---- Leader and coded data ------------------------------------------

record -> LDR "{LDR/0-4}{LDR/5|tr(status)}{LDR/6|tr(type)}{LDR/7|tr(level)}  2200000{LDR/17|tr(encoding)}{LDR/18|replace('^ $', 'n')|replace('^[aci]$', ' ')|replace('^u$', 'i')} 450 "

# 100 general processing data. Date entered: 008/00-05, 00-29 read as
# 20XX (MARC 21 records date from 1968). Target audience (008/22) and
# government publication (008/28) only exist for some types; character
# set: UTF-8 (50), script of title: Latin (ba).
record when LDR~^.{6}([gkmor].|[at][^bis]) -> 100 [##] { -> $a "{008/0-5|replace('^([0-2])', '20$1')|replace('^([3-9])', '19$1')}{008/6|tr(datetype)}{008/7-10|tr(unknown)}{008/11-14|tr(unknown)}{008/22|replace('[ |]', 'u')|tr(audience)}  {008/28|replace(' ', 'y')|tr(government)}{008/38|replace('^x$', '1')|replace('^[^1]$', '0')}{040b|default('eng')}{066|exists('g', 'y')}50      ba" }
record when LDR~^.{6}[cdij] -> 100 [##] { -> $a "{008/0-5|replace('^([0-2])', '20$1')|replace('^([3-9])', '19$1')}{008/6|tr(datetype)}{008/7-10|tr(unknown)}{008/11-14|tr(unknown)}{008/22|replace('[ |]', 'u')|tr(audience)}  u{008/38|replace('^x$', '1')|replace('^[^1]$', '0')}{040b|default('eng')}{066|exists('g', 'y')}50      ba" }
record when LDR~^.{6}([ef].|a[bis]) -> 100 [##] { -> $a "{008/0-5|replace('^([0-2])', '20$1')|replace('^([3-9])', '19$1')}{008/6|tr(datetype)}{008/7-10|tr(unknown)}{008/11-14|tr(unknown)}u  {008/28|replace(' ', 'y')|tr(government)}{008/38|replace('^x$', '1')|replace('^[^1]$', '0')}{040b|default('eng')}{066|exists('g', 'y')}50      ba" }
record when LDR~^.{6}p -> 100 [##] { -> $a "{008/0-5|replace('^([0-2])', '20$1')|replace('^([3-9])', '19$1')}{008/6|tr(datetype)}{008/7-10|tr(unknown)}{008/11-14|tr(unknown)}u  u{008/38|replace('^x$', '1')|replace('^[^1]$', '0')}{040b|default('eng')}{066|exists('g', 'y')}50      ba" }

# 101 language: 041 with MARC codes (not those with a $2), else 008/35-37
041 when !$2 -> 101 [{@ind1|replace(' ', '0')}#] {
  $a -> $a
  $d -> $a
  $k -> $b
  $h -> $c
  $b -> $d
  $f -> $e
  $e -> $h
  $g -> $i
  $j -> $j
}
record when !041 -> 101 [0#] { -> $a "{008/35-37|trim|replace('^\|+$', '')}" }

record -> 102 [##] { -> $a "{008/15-17|trim|table(country)}" }

# 105 textual material (books)
record when LDR~^.{6}[at][^bis] -> 105 [##] { -> $a "{008/18-21|tr(illustrations)|replace('^    $', 'y   ')}{008/24-27|tr(contents)}{008/29}{008/30}{008/31}{008/33|tr(literature)}{008/34|replace(' ', 'y')}" }

# 106 form of item (textual material, printed music); electronic and
# microform are obsolete codes there, given by 182 instead
record when LDR~^.{6}[acdpt] -> 106 [##] { -> $a "{008/23|replace(' ', 'r')|tr(itemform)|replace('^[st]$', '')}" }

# 110 continuing resources: type, frequency, regularity, nature of the
# entire work and of contents, conference; title page and index
# availability are not in MARC 21
record when LDR~^.{6}a[is] -> 110 [##] { -> $a "{008/21|tr(serialtype)}{008/18|replace(' ', 'y')|tr(frequency)}{008/19|tr(regularity)}{008/24-27|tr(serialcontents)}{008/29}|||" }

# Visual projections, video recordings, motion pictures (007/00 m, v,
# g). shortcut: $b (film archives) is not produced.
007 when ~^m -> 115 [##] { -> $a "a{008/18-20|replace('[-n|]', ' ')}{/3|tr(colour115)}{/5|replace(' ', 'y')}{/6|replace(' ', 'x')}{/7|tr(width115m)}{/1|tr(release115m)}{008/34|tr(technique115)}{/4|tr(format115m)}||||x|xx|" }
007 when ~^v -> 115 [##] { -> $a "c{008/18-20|replace('[-n|]', ' ')}{/3|tr(colour115)}{/5|replace(' ', 'y')}{/6|replace(' ', 'x')}{/7|tr(width115v)}x{008/34|tr(technique115)}x||||{/1|tr(release115v)}{/4|tr(format115v)}xx|" }
007 when ~^g -> 115 [##] { -> $a "b{008/18-20|replace('[-n|]', ' ')}{/3|tr(colour115)}{/5|replace(' ', 'y')}{/6|replace(' ', 'x')}{/7|tr(width115g)}{/1|tr(release115g)}xx||||xx{/4|tr(emulsion115)}|#" | replace('#$', ' ') }

# Graphics (007/00 k): techniques and function are not in MARC 21
007 when ~^k -> 116 [##] { -> $a "{/1|tr(smd116)}{/4|tr(support116)}{/5|tr(support116)|default('y')}{/3|tr(colour116)}||||||||||||||" }

# Cartographic resources: 120 from 008 (and the first 007 if it is a
# map's), 121 and 124 from each map 007
record when LDR~^.{6}[ef] -> 120 [##] { -> $a "{007/0-3|replace('^a..(.)$', '$1')|replace('^.{2,}$', '|')|tr(colour120)|default('|')}{008/31|tr(index120)}|{008/18-21|replace('^    $', 'x   ')}{008/22-23|replace('^  $', 'uu')}||||" }
007 when ~^a -> 121 [##] { -> $a "a||{/4|tr(medium121)}{/6|tr(technique121)}{/5|tr(reproduction121)}|{008/25|tr(form121)}" }
007 when ~^d -> 121 [##] { -> $a "b||{/4|tr(medium121)}{/6|tr(technique121)}{/5|tr(reproduction121)}|z" }
007 when ~^a -> 124 [##] { -> $b "{/1|tr(form124)}" }
007 when ~^d -> 124 [##] { -> $b "c" }

# Music: format of notated music and parts (scores), literary text
# (spoken recordings)
record when LDR~^.{6}[cd] -> 125 [##] { -> $a "{008/20|tr(score125)}{008/21|replace(' ', 'y')|tr(parts125)}" }
record when LDR~^.{6}i -> 125 [##] { -> $b "{008/30-31|tr(literary125)|replace('^ +$', '')}" }

# Form of musical work: the IAML codes (128) extend the MARC 21 ones
# (008/18-19, 047) with a third character, often blank. Multiple forms
# (mu) are in 047; not applicable, unknown and other are not coded.
record when LDR~^.{6}[cdij] -> 128 [##] { -> $a "{008/18-19|replace('^(mu|nn|uu|zz|\|\|)$', '')|replace('^(..)$', '$1 ')}" }
047 -> 128 [##] { $a -> $a | replace('^(..)$', '$1 ') }

# Sound recordings (007/00 s). shortcut: $b (pre-LRM) is not produced.
007 when ~^s -> 126 [##] { -> $a "{/1|tr(release126)}{/3|tr(speed126)}{/4|tr(sound126)}{/5|tr(groove126)}{/6|tr(size126)}{/7|tr(tapewidth126)}{/8|tr(tapeconfig126)}{008/24-29|tr(accompanying126)|default('||||||')}{/13|tr(technique126)|default('|')}{/12|tr(special126)|default('|')}" }

# Microforms (007/00 h)
007 when ~^h -> 130 [##] { -> $a "{/1|tr(smd130)}{/3|tr(polarity130)}{/4-5}{/6-8|replace('^---$', '   ')|replace('-', 'u')}{/9|tr(colour130)}{/10|tr(emulsion130)}{/11|tr(generation130)}{/12|tr(base130)}|||||||||||" | replace('^(.{11}).*$', '$1') }

# Electronic resources (007/00 c): positions 1-12 follow 007/01 and
# 007/03-13 code for code; short 007 are filled with "|". The type is in
# 008/26 for computer files, else in a computer file 006 (006/09).
007 when ~^c when LDR~^.{6}m -> 135 [##] { -> $a "{008/26|replace('m', 'v')}{/1}{/3-13}||||||||||||" | replace('^(.{13}).*$', '$1') }
007 when ~^c when !LDR~^.{6}m when 006~^m -> 135 [##] { -> $a "{006/9|replace('m', 'v')}{/1}{/3-13}||||||||||||" | replace('^(.{13}).*$', '$1') }
007 when ~^c when !LDR~^.{6}m when !006~^m -> 135 [##] { -> $a "{LDR/6|tr(etype)|replace('^[^cdh]$', 'u')}{/1}{/3-13}||||||||||||" | replace('^(.{13}).*$', '$1') }

# ---- Alternate graphic representations -------------------------------

# An 880 is converted by the rules of the field it pairs with (its $6),
# and both carry $6 "a" + linking number; the 880's also $7 for its
# script. An 880 without pair (linking number 00) only carries $7.
880 -> linked

common {
  $6 -> $6 | replace('^\d{3}-00.*$', '') | replace('^\d{3}-(\d\d).*$', 'a$1'), $7 "{}|{008/35-37}" | replace('^[^/]*$', '') | replace('^[^/]*/', '') | replace('^\$1\|(.*)$', 'cjk-$1') | replace('^(\(.).*$', '$1') | table(scripts)
}

