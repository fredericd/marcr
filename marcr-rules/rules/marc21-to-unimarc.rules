  -> $2 "nlm"
}
080 -> 675 [##] {
  $a -> $a "{}{$x*|join('')}"
  $2 -> $v
}
# Prime marks are left out
082 -> 676 [##] {
  $a[1] -> $a | replace('/', '')
  $2 -> $v
}
084 -> 686 [##] {
  $a -> $a
  $b -> $c
  $2 -> $2
}

