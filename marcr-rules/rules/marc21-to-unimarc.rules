# Subject heading indicator 2 -> $2 (4 and 7: no code, or the field's $2)
table subjectsource {
  0 = lcsh
  1 = lcshac
  2 = mesh
  3 = nal
  4 = ""
  5 = cash
  6 = rvm
  7 = ""
}

# 015 $2 -> country of the national bibliography (020 $a)
table nbsource {
  bnb = GB
  dnb = DE
  nznb = NZ
  bnf = FR
  ccb = CN
  sanb = ZA
  can = CA
}

# Organization code -> country (801 $a)
table orgcountry {
  DLC = US
  DNLM = US
  DNAL = US
  NjP = US
  UKMGB = GB
  NLC = CA
  CaOONL = CA
  * = ""
}

# 246 indicator 1: added entry -> title significant (5XX indicator 1)
table added {
  0 = 0
  1 = 1
  2 = 0
  3 = 1
}

# MARC indicator "display note" (0) -> UNIMARC "print note" (1)
table note {
  0 = 1
  1 = 0
}

# 490 indicator 1 (0 untraced, 1 traced differently) -> 225 indicator 1
table ind225 {
  0 = 1
  1 = 0
}

# 264 indicator 2 (0 production, 1 publication) -> 214 indicator 2
table ind214 {
  0 = 1
  1 = 0
}

# 505 indicator 1 (0 complete, 1 incomplete, 2 partial) -> 327 indicator 1
table ind327 {
  0 = 1
  1 = 0
  8 = 1
}

# 028 indicator 1 (6 distributor number) and 2 (note) -> 071
table ind071 {
  6 = 5
}
table note071 {
  0 = 0
  1 = 1
  2 = 1
  3 = 0
}

# 880 $6 script identification (with the language for CJK, 008/35-37)
# -> $7 alphabet/script (100/34-35 codes); Latin is not given
table scripts {
  "(3" = fa
  "(B" = ""
  "(N" = ca
  "(S" = ga
  "(2" = ha
  cjk-chi = ea
  cjk-jpn = da
  cjk-kor = ka
  * = zz
}

# ---- Tables for coded data by type of resource (UNIMARC Bibliographic
# Format Manual, 1.1.0, 2024) ----------------------------------------

