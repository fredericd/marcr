}
334 -> 586 [##] { $a -> $a ; $b -> $a ; $c -> += ", {}" }
336 -> 516 [##] { $a -> $a | replace('([^.)\]?!])$', '$1.') }
317 -> 561 [##] { $a -> $a }
320 -> 504 [##] { $a -> $a | replace('([^.)\]?!])$', '$1.') }
327 -> 505 [{@ind1|table(ind505)}#] { $a[1] -> $a ; $a[2..] -> += " -- {}" }
328 -> 502 [##] { $b -> $a ; $c -> += " : {}" ; $e -> += " : {}" ; $d -> += " : {}" }
330 -> 520 [##] { $a -> $a ; $2 -> $c ; end "." }
314 -> 550 [##] { $a -> $a }
324 -> 534 [##] { $a -> $a ; end "." }
326 -> 310 [##] { $a -> $a }
337 -> 538 [##] { $a -> $a ; end "." }
371 -> 506 [##] { $8 -> $3 ; $a -> $a ; $c -> $e }
359 -> 559 { $* -> $* }

# ---- Linking entries ------------------------------------------------

# The ISSN is not kept with a volume number
410 when !$v -> 760 [0#] {
  $t -> $t | strip_nsb
  $c -> $d
  $n -> += " : {}"
  $d -> += ", {}"
  $x -> $x
  $0 -> $w "(ABES){}"
  order $t $d $x $w
}
410 when $v -> 760 [0#] {
  $t -> $t | strip_nsb
  $c -> $d
  $n -> += " : {}"
  $d -> += ", {}"
  $v -> $g
  $0 -> $w "(ABES){}"
  order $t $d $g $w
}
# Other physical format, with its title, responsibility, publication and
# series composed as in an ISBD display
452 456 -> 776 [0#] {
  $t -> $t | strip_nsb
  $h -> += ". {}"
  $i -> += ",  {}"
  $o -> += " : {}"
  $f -> += " / {}"
  $e -> $b
  $c -> $d
  $n -> += " : {}"
  $d -> += ", {}"
  $p -> $h
  $s -> += ". (@{})"
  $y -> $z
  $x -> $x
  $0 -> $w "(ABES){}"
  order $t $b $d $h $x $z $w
}
# Host item; $7 tells the host is a serial when this record is a monograph.
# A part (463) with a record of its own is a host too.
461 -> 773 [0#] {
  $t -> $t | strip_nsb
  $h -> += ". {}"
  $i -> += ",  {}"
  $l -> += " {}"
  $o -> += " : {}"
  $f -> += " / {}"
  $e -> $b
  $c -> $d
  $n -> += " : {}"
  $d -> += ", {}"
  $p -> $h
  $s -> += ". (@{})"
  $v -> $g
  $y -> $z
  $0 -> $w "(ABES){}", $7 {LDR/7|table(level)}
  order $t $b $d $h $g $z $w $7
}
# A responsibility left in $t is dropped
464 -> 774 [0#] {
  $t -> $t | strip_nsb | replace(' / .*$', '')
  $h -> += ". {}"
  $i -> += ",  {}"
  $l -> += " @{}"
  $e -> += " : {}"
  $f -> += " / {}"
  $d -> $d
  $p -> $h
  $v -> $g
  order $t $d $h $g
}
