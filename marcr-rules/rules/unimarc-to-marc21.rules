}

# 135 $a/0, type of computer file -> 008/26 (electronic resources)
table filetype {
  v = m
}

# 135 $a, coded data for electronic resources -> 007 (characters):
# unknown "|" becomes "u", not applicable "#" becomes "|"
table electronic {
  "|" = u
  "#" = "|"
}

# 115 $a/0, type of visual material -> 008/33 (videos)
table visual {
  a = m
  c = v
}

