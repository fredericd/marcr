328 -> 502 [##] { $b -> $a ; $c -> += " : {}" ; $e -> += " : {}" ; $d -> += " : {}" }
330 -> 520 [##] { $a -> $a ; $2 -> $c ; end "." }
314 -> 550 [##] { $a -> $a }
324 -> 534 [##] { $a -> $a ; end "." }
326 -> 310 [##] { $a -> $a }
337 -> 538 [##] { $a -> $a ; end "." }
371 -> 506 [##] { $8 -> $3 ; $a -> $a ; $c -> $e }
359 -> 559 { $* -> $* }

# ---- Linking entries ------------------------------------------------

# The ISSN is not kept with a volume number
410 when !$v -> 760 [0#] {
