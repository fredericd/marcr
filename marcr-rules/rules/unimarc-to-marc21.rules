# ---- Names ----------------------------------------------------------

# Dates and qualifier in parentheses: "(1913-1960 ; poète)"
700 when $b -> 100 [1#] {
  $3 -> $0 "(IdRef){}", $1 "http://www.idref.fr/{}/id"
  # A forename ending with an initial takes a period
  $a -> $a "{|trim}, {$b|trim|replace('(\b[A-Z])$', '$1.')}"
  # An end date of dots has four of them ("1998-....." -> "1998-....")
  $f -> $d "({|replace('-\.\.\.\.$', '-....#')|replace('-(\.+)\.$', '-$1')|replace('#$', '')}{$c|exists('; ', ')')}"
  $c[1] -> $c "{$f|exists('', '(')}{}"
  $c[2..] -> += " ; {}"
  $c[-1] -> += ")"
  $4 -> $4 {|table(roles, 1)}, $e {|table(roles, 2)} before "." after $e
  order $0 $1 $a $d $c $4 $e
  end "." skip $0 $1 $4 $e
}
# Forenames only (sovereigns, saints...): qualifier before dates,
# "(reine de France ; 1601-1666)"
701 702 when !$b -> 700 [0#] {
  $3 -> $0 "(IdRef){}", $1 "http://www.idref.fr/{}/id"
  $a -> $a
  $d -> $b
  $c[1] -> $c "({}"
  $c[2..] -> += " ; {}"
  $c[-1] -> += "{$f|exists(' ; ', ')')}"
  $f -> $d "{$c|exists('', '(')}{|replace('-\.\.\.\.$', '-....#')|replace('-(\.+)\.$', '-$1')|replace('#$', '')})"
  $4 -> $4 {|table(roles, 1)}, $e {|table(roles, 2)} before "." after $e
  order $0 $1 $a $b $c $d $4 $e
  end "." skip $0 $1 $4 $e
}
