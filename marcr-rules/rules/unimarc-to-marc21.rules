# UNIMARC to MARC21, written after the conversion of the Sudoc (Abes) and
# evaluated on pairs of Sudoc records (see corpus/ in the marcr-rules
# repository).
#
# Literal texts are written decomposed (NFD), as in Sudoc records: an
# "è" typed as one character would not match.

rules "UNIMARC to MARC21 (Sudoc)"
version 0.1

# ---- Tables ---------------------------------------------------------

# UNIMARC relator code -> MARC21 relator code, label
table roles {
  003 = dgs., Encadrant académique
  005 = act., Acteur
  010 = adp., Adaptation
  030 = arr., Arrangement / Réduction
  040 = art., Artiste
  065 = auc., Commissaire-priseur
  070 = aut., Auteur
  072 = aqt., Auteur cité
  075 = aft., Postface
  080 = aui., Préface
  100 = ant., Auteur adapté /précédent
  130 = bkd., Maquette
  180 = ctg., Cartographie
  195 = cnd., Chef de choeur
  200 = chr., Chorégraphie
  205 = col., Collaborateur
  212 = ann., Notes
  230 = mus., Musique
  245 = ccp., Idée originale
  250 = cnd., Chef d'orchestre
  255 = csp., Consultant
  273 = cur., Commissaire
  280 = dte., Dédicataire
  295 = dgg., Organisme de soutenance
  300 = rsg., Réalisateur / Metteur en scène / Directeur artistique
  330 = dub., Auteur prétendu
  340 = edt., Éditeur scientifique
  350 = egr., Gravure
  365 = exp., Expert
  390 = fmo., Ancien possesseur
  410 = art., Technicien graphique
  440 = ill., Illustrations / Graphisme
  460 = ive., Participant
  470 = ivr., Intervieweur
  475 = isb., Collectivité éditrice
  480 = lbt., Livret
  530 = mte., Gravure
  545 = itr., Instrumentiste
  550 = nrt., Voix parlée
  555 = opn., Membre du jury
  557 = orm., Organisation du congrès
  590 = prf., Exécutant
  600 = pht., Photographie
  610 = prt / prt-bsl., Imprimeur / Imprimeur-libraire
  630 = pmn., Directeur de production
  632 = ard., Scénographe / Chef costumier
  633 = tcd., Accessoiriste
  650 = pbl., Éditeur commercial
  651 = pbd., Directeur de la publication
  660 = rcp., Destinataire
  690 = sce., Scénario
  721 = sng., Chant
  727 = ths., Directeur de thèse
  730 = trl., Traduction
  956 = 956., Président du jury de soutenance
  958 = 958., 958 (Rapporteur du travail universitaire)
  981 = 981., 981 (Laboratoire associé au travail universitaire)
  982 = 982., 982 (Entreprise associée au travail universitaire)
  984 = 984., 984 (Équipe de recherche associée au travail universitaire)
  985 = 985., 985 (Autre partenaire associé au travail universitaire)
  995 = 995., Organisme de cotutelle
  996 = 996., Ecole doctorale associée au travail universitaire
}

# Leader/06, type of record
table type {
  a = a
  b = t
  c = c
  d = d
  e = e
  f = f
  g = g
  i = i
  j = j
  k = k
  l = m
  m = o
  r = r
}

# 073 2nd indicator -> 024 2nd indicator
table ind024 {
  0 = "#"
  1 = 0
}

# 101 1st indicator (translation) -> 041 1st indicator
table ind041 {
  0 = 0
  1 = 1
  2 = 1
  * = 0
}

# 225 1st indicator -> 490 1st indicator (series traced or not)
table ind490 {
  1 = 0
  * = 1
}

# 214 2nd indicator (function) -> 264 2nd indicator
table ind264 {
  0 = 1
  1 = 0
  2 = 2
  3 = 3
  4 = 4
}

# 100 $a/8, type of publication date -> 008/06
table datetype {
  a = c
  b = d
  c = u
  d = s
  e = r
  f = q
  g = m
  h = t
  i = p
  j = e
}

# 102 $a, ISO 3166 country -> MARC country code (008/15-17)
# shortcut: only the countries found in the Sudoc corpus; add others from
# the MARC Code List for Countries when needed.
table country {
  AR = "ag "
  AT = "au "
  BE = "be "
  CA = "cn "
  CG = "cf "
  CH = "sz "
  CZ = "xr "
  DE = "gw "
  ES = "sp "
  FR = "fr "
  GB = "uk "
  GR = "gr "
  IL = "is "
  IN = "ii "
  IT = "it "
  JP = "ja "
  KR = "ko "
  LU = "lu "
  MQ = "mq "
  MX = "mx "
  NL = "ne "
  PK = "pk "
  PL = "pl "
  PT = "po "
  RO = "rm "
  RU = "ru "
  SA = "su "
  SE = "sw "
  SG = "si "
  SI = "xv "
  UA = "un "
  US = "us "
  XX = "xx "
  ZZ = "vp "
}

# 100 $a/17, target audience -> 008/22 (books)
table audience {
  a = j
  k = f
  m = g
  u = " "
}

# 100 $a/20, government publication -> 008/28
table government {
  a = f
  b = s
  d = l
  e = c
  f = i
  h = o
  y = " "
}

# 105 $a/0-3, illustrations -> 008/18-21 (characters)
table illustrations {
  o = p
  y = " "
  " " = "#"
}

# 105 $a/4-7, form of contents -> 008/24-27 (characters)
table contents {
  a = b
  b = c
  c = i
  d = a
  e = d
  f = e
  g = r
  i = s
  j = p
  k = j
  l = u
  n = l
  p = t
  r = n
  s = z
  t = " "
  v = m
  z = " "
  7 = m
}

# 105 $a/11, literary form -> 008/33
table literature {
  a = 1
  b = d
  c = e
  d = h
  e = i
  f = j
  g = p
  h = s
  y = 0
  z = m
}

# 105 $a/12, biography -> 008/34
table biography {
  y = " "
}

# 135 $a/0, type of computer file -> 008/26 (electronic resources)
table filetype {
  v = m
}

# 135 $a, coded data for electronic resources -> 007 (characters):
# unknown "|" becomes "u", not applicable "#" becomes "|"
table electronic {
  "|" = u
  "#" = "|"
}

# 115 $a/0, type of visual material -> 008/33 (videos)
table visual {
  a = m
  c = v
}

# 4XX tag -> 780/785 indicator 2 (relationship)
table ind780 {
  430 = 0
  431 = 1
  432 = 2
  433 = 3
  434 = 5
  435 = 6
  436 = 4
  437 = 7
  440 = 0
  441 = 1
  442 = 2
  443 = 3
  444 = 4
  445 = 5
  446 = 6
  447 = 7
  448 = 8
}

# 327 indicator 1 -> 505 indicator 1 (complete, incomplete, partial)
table ind505 {
  0 = 1
  1 = 0
  2 = 2
  * = 8
}

# Bibliographic level of the record (LDR/7) -> 773 $7 of the host
table level {
  m = "   s"
}

# 106 $a/0 -> 008/23 (books): form of item
table itemform {
  h = " "
  i = " "
  z = " "
}

# 115 $a/9 -> 008/34 (videos): technique
table technique {
  b = l
  x = n
}

# 120 $a/3 -> 008/18 (maps): relief
table relief {
  " " = "|"
  x = " "
}

# 120 $a/7-8 -> 008/22-23 (maps): projection
table projection {
  u = " "
  x = " "
}

# 121 $a/8 -> 008/25 (maps): type of cartographic material
table maptype {
  b = c
  c = e
  e = g
}

# 105 $a/11 -> 008/31 (maps): index
table mapindex {
  y = 0
}

# 121 $a/5 -> 008/33 (maps): special format characteristics
table mapformat {
  b = z
  u = " "
}

# 125 $a/0 -> 008/20 (scores, sound recordings): format of music
table scoreformat {
  h = "|"
  l = "|"
  x = "|"
}

# 126 $a/7-10 -> 008/24-27 (sound recordings): accompanying matter
table accompanying {
  j = z
}

# 125 $b/0 -> 008/30 (sound recordings): literary text
table literary {
  a = p
  b = d
  c = f
  d = h
  e = l
  j = e
  k = g
  n = t
  p = j
  r = k
  s = o
}

# 116 $a/0 -> 008/33 (images): type of visual material
table imagetype {
  b = "|"
  d = c
  f = "|"
  h = i
  i = "|"
  k = l
  z = k
}

# 110 $a/1 -> 008/18 (serials): frequency
table frequency {
  a = d
  c = w
  e = s
  f = m
  g = b
  h = q
  i = t
  j = f
  k = a
  y = " "
}

# 110 $a/2 -> 008/19 (serials): regularity
table regularity {
  a = r
  b = n
  y = x
}

# 100 $a/17 -> 008/20 (serials), as Abes fills it
table serialcentre {
  k = " "
  m = " "
  u = z
  "|" = " "
}

# 110 $a/0 -> 008/21 (serials): type of continuing resource
table serialtype {
  a = p
  b = m
  c = n
  j = i
  m = g
  n = s
}

# 110 $a/3-4 -> 008/24-25 (serials): nature of contents
table serialcontents {
  "#" = "|"
  g = r
  i = s
  z = " "
}

# 110 $a/9 -> 008/26-27 (serials)
table conference {
  u = "|"
  x = " "
  y = " "
  z = "|"
}

# 124 $b/0 -> 007/1 (maps): specific material designation
table mapform {
  a = d
  d = j
  i = y
  j = "|"
}

# 120 $a/0 -> 007/3 (maps): colour
table mapcolour {
  b = c
}

# 121 $a/4-5 -> 007/4, 007/6 (maps): physical medium, reproduction
table mapmedium {
  b = z
  j = z
}

# 115 $a/0 -> 007/0 (videos): category of material
table videotype {
  a = m
  b = g
  c = v
}

# 115 $a/15 -> 007/1 (videos): specific material designation
table videoformat {
  b = d
  c = f
  x = "|"
}

# 115 $a/4 -> 007/3 (videos): colour
table videocolour {
  a = b
  b = a
  c = m
}

# 115 $a/16 -> 007/4 (videos): videorecording format
table videovideo {
  k = v
}

# 115 $a/5-6, $b/5 -> 007/5-6, 007/8 (videos): sound
table videosound {
  b = s
  x = n
  y = " "
}

# 126 $a/0 -> 007/1 (sound recordings): specific material designation
table sounddisc {
  a = d
  c = s
}

# 126 $a/1 -> 007/3 (sound recordings): speed
table soundspeed {
  g = f
  k = l
}

# 126 $a/2 -> 007/4 (sound recordings): playback channels
table soundchannels {
  a = m
  b = s
}

# 126 $a/3-6, $b/0-2 -> 007/5-10 (sound recordings)
table soundcoded {
  x = n
}

# 126 $a/3, $b/0 -> 007/5, 007/8 (sound recordings): groove, kind of disc
table soundgroove {
  b = m
  x = n
}

# 126 $a/5 -> 007/6 (sound recordings): dimensions
table soundsize {
  b = o
  d = l
  x = n
}

# 126 $b/1 -> 007/9 (sound recordings): kind of material
table soundmaterial {
  d = p
  e = m
  h = p
  x = n
}

# 126 $b/2 -> 007/10 (sound recordings): kind of cutting
table soundcutting {
  b = h
  x = n
}

# 126 $a/14 -> 007/12 (sound recordings): capture technique
table soundcapture {
  d = e
  f = c
}

# 126 $a/13 -> 007/11 (sound recordings): special playback
table soundplayback {
  b = e
  c = d
}

# 116 $a/0 -> 007/1 (images): specific material designation
table imagematerial {
  a = c
  b = d
  d = f
  f = h
  h = i
  i = j
  k = l
}

# 116 $a/1-3 -> 007/3-5 (images): colour, support
table imagecolour {
  d = h
  i = o
}

# 510 $z -> 246 (parallel titles): language names, in French as Abes
# gives them (ISO 639-2 French names, decomposed: NFD)
# shortcut: 55 common languages of about 480, add the others when met
table langname {
  fre = français
  eng = anglais
  ger = allemand
  spa = "espagnol ; castillan"
  ita = italien
  por = portugais
  dut = "néerlandais ; flamand"
  lat = latin
  grc = grec ancien (jusqu'à 1453)
  gre = grec moderne (après 1453)
  rus = russe
  pol = polonais
  cze = tchèque
  slo = slovaque
  slv = slovène
  hrv = croate
  srp = serbe
  bul = bulgare
  ukr = ukrainien
  rum = "roumain ; moldave"
  hun = hongrois
  fin = finnois
  est = estonien
  lav = letton
  lit = lituanien
  dan = danois
  swe = suédois
  nor = norvégien
  ice = islandais
  gle = irlandais
  wel = gallois
  bre = breton
  baq = basque
  cat = "catalan ; valencien"
  oci = occitan (après 1500)
  ltz = luxembourgeois
  tur = turc
  ara = arabe
  heb = hébreu
  per = persan
  arm = arménien
  geo = géorgien
  alb = albanais
  hin = hindi
  san = sanskrit
  chi = chinois
  jpn = japonais
  kor = coréen
  vie = vietnamien
  tha = thaï
  ind = indonésien
  epo = espéranto
  yid = yiddish
  mul = multilingue
  und = indéterminée
}

# 123 indicator 1 -> 034 indicator 1 (type of scale)
table ind034 {
  0 = 0
  1 = 1
  2 = 3
  3 = 3
  4 = 0
}

# ---- Leader and control fields --------------------------------------

record -> LDR "{LDR/0-4}{LDR/5}{LDR/6|table(type)}{LDR/7} a2200000 i 4500"
record when 801 -> 040 [##] { -> $a "ABES" ; -> $b "fre" ; -> $e "AFNOR" }

# 008: dates and country, then the positions of the type of material,
# then language. Date 2 is "||||" for a single date (d), its unknown
# digits are "u". Illustrations are "||||" when 105 is not filled in.
record when LDR~^.{6}[abt][^s] -> 008 "{100a/2-7}{100a/8|table(datetype)}{100a/9-12|replace(' ', 'u')}{100a/8-16|replace('^d.{4} {4}$', '||||')|replace('^.{5}(.{4})$', '$1')|replace(' ', 'u')}{102a|table(country)|default('xx ')}{105a/0-4|replace('^y   \|$', '|||||')|replace('^(.{4}).$', '$1')|tr(illustrations)}{100a/17|tr(audience)}{106a/0|tr(itemform)|default('|')}{105a/4-7|tr(contents)}{100a/20|tr(government)}{105a/8-10} {105a/11|tr(literature)}{105a/12|tr(biography)}{101a} d"
# Maps
record when LDR~^.{6}[ef] -> 008 "{100a/2-7}{100a/8|table(datetype)}{100a/9-12|replace(' ', 'u')}{100a/8-16|replace('^d.{4} {4}$', '||||')|replace('^.{5}(.{4})$', '$1')|replace(' ', 'u')}{102a|table(country)|default('xx ')}{120a/3|tr(relief)|default('|')}{120a/3|replace('^[^ ]$', '   ')|replace('^ $', '|||')|default('|||')}{120a/7-8|tr(projection)|default('||')}|{121a/8|tr(maptype)|default('|')}||{100a/20|tr(government)}  {105a/11|tr(mapindex)|default('|')}|{121a/5|tr(mapformat)|default('|')}|{101a} d"
# Scores: form of composition (MARC codes only, others "zz"), format
record when LDR~^.{6}[cd] -> 008 "{100a/2-7}{100a/8|table(datetype)}{100a/9-12|replace(' ', 'u')}{100a/8-16|replace('^d.{4} {4}$', '||||')|replace('^.{5}(.{4})$', '$1')|replace(' ', 'u')}{102a|table(country)|default('xx ')}{128a/0-1|replace('^(ai|ar|in|li|pf)$', 'zz')|default('||')}{125a/0|tr(scoreformat)|default('|')}|{100a/17|tr(audience)}{106a/0|default('|')}|||||||||||{101a} d"
# Sound recordings: accompanying matter (126), literary text (125 $b)
record when LDR~^.{6}[ij] -> 008 "{100a/2-7}{100a/8|table(datetype)}{100a/9-12|replace(' ', 'u')}{100a/8-16|replace('^d.{4} {4}$', '||||')|replace('^.{5}(.{4})$', '$1')|replace(' ', 'u')}{102a|table(country)|default('xx ')}{128a/0-1|replace('^(ai|ar|in|li|pf)$', 'zz')|default('||')}{125a/0|tr(scoreformat)|default('|')}|{100a/17|tr(audience)}|{126a/7-10|tr(accompanying)|default('||||')}{126a/7|replace('^\|$', '||')|replace('^[^|]$', '  ')|default('||')}{125b/0|tr(literary)|replace('^(.)$', '$1 ')|default('||')}|||{101a} d"
# Images: type of material (116)
record when LDR~^.{6}k -> 008 "{100a/2-7}{100a/8|table(datetype)}{100a/9-12|replace(' ', 'u')}{100a/8-16|replace('^d.{4} {4}$', '||||')|replace('^.{5}(.{4})$', '$1')|replace(' ', 'u')}{102a|table(country)|default('xx ')}---|{100a/17|tr(audience)}|||||{100a/20|tr(government)}    {116a/0|tr(imagetype)|default(' ')}|{101a} d"
# Serials (110): frequency, regularity, type, contents
record when LDR~^.{6}as -> 008 "{100a/2-7}{100a/8|table(datetype)}{100a/9-12|replace(' ', 'u')}{100a/8-16|replace('^d.{4} {4}$', '||||')|replace('^.{5}(.{4})$', '$1')|replace(' ', 'u')}{102a|table(country)|default('xx ')}{110a/1|tr(frequency)|default('|')}{110a/2|tr(regularity)|default('|')}{100a/17|tr(serialcentre)|default('z')}{110a/0|tr(serialtype)|default('|')}{106a/0|default('|')}{106a/0|default('|')}{110a/3|tr(serialcontents)|default('|')}{110a/4|tr(serialcontents)|default('|')}{110a/9|tr(conference)|default('|')}{110a/9|tr(conference)|default('|')}{100a/20|tr(government)}|||||0{101a} d"
record when LDR~^.{6}l -> 008 "{100a/2-7}{100a/8|table(datetype)}{100a/9-12|replace(' ', 'u')}{100a/8-16|replace('^d.{4} {4}$', '||||')|replace('^.{5}(.{4})$', '$1')|replace(' ', 'u')}{102a|table(country)|default('xx ')}||||{100a/17|tr(audience)}|||{135a/0|tr(filetype)|default('|')} {100a/20|tr(government)}||||||{101a} d"
record when LDR~^.{6}g -> 008 "{100a/2-7}{100a/8|table(datetype)}{100a/9-12|replace(' ', 'u')}{100a/8-16|replace('^d.{4} {4}$', '||||')|replace('^.{5}(.{4})$', '$1')|replace(' ', 'u')}{102a|table(country)|default('xx ')}{115a/1-3|replace('\|', '-')|default('---')}|{100a/17|tr(audience)}|||||{100a/20|tr(government)}    {115a/0|tr(visual)}{115a/9|tr(technique)|default('|')}{101a} d"

# 007 of electronic resources, from 135 (bit depth always "---")
# 007 of maps, videos, sound recordings and images, from their coded fields
record when LDR~^.{6}[ef] -> 007 "a{124b/0|tr(mapform)|default('|')}|{120a/0|tr(mapcolour)|default('|')}{121a/4|tr(mapmedium)|default('|')}u{121a/5|tr(mapmedium)|default('|')}n"
record when LDR~^.{6}g when 115 -> 007 "{115a/0|tr(videotype)}{115a/15|tr(videoformat)}|{115a/4|tr(videocolour)}{115a/16|tr(videovideo)}{115a/5|tr(videosound)}{115a/6|tr(videosound)}{115a/7}{115b/5|tr(videosound)|default('|')}"
record when LDR~^.{6}[ij] when 126 -> 007 "s{126a/0|tr(sounddisc)}|{126a/1|tr(soundspeed)}{126a/2|tr(soundchannels)}{126a/3|tr(soundgroove)}{126a/5|tr(soundsize)}{126a/6|tr(soundcoded)}{126b/0|tr(soundgroove)|default('|')}{126b/1|tr(soundmaterial)|default('|')}{126b/2|tr(soundcutting)|default('|')}{126a/14|tr(soundcapture)}{126a/13|tr(soundplayback)}"
record when LDR~^.{6}k when 116 -> 007 "k{116a/0|tr(imagematerial)}|{116a/3|tr(imagecolour)}{116a/1|tr(imagecolour)}{116a/2|tr(imagecolour)}"
record when LDR~^.{6}l -> 007 "c{135a/1|tr(electronic)|default('u')}|{135a/2-4|tr(electronic)|default('uuu')}---{135a/8-12|tr(electronic)|default('uuuuu')}"

001 -> 001
005 -> 005 "{/0-15}"

# ---- 0XX ------------------------------------------------------------

010 -> 020 [##] {
  $a -> $a | replace('-', '')
  $b -> += " ({|replace('\.$', '')})"
  $d -> $c
  $z -> $z | replace('-', '')
}
035 -> 035 [##] { $a -> $a ; $z -> $z }
123 -> 034 [{@ind1|table(ind034)}#] { $a -> $a ; $b -> $b ; $c -> $c ; $d -> $d ; $e -> $e ; $f -> $f ; $g -> $g }
# Abes copies 128 as is to 047, blanks as "#": here the form of composition
# goes to 047, the instruments and voices to 048
128 when $a -> 047 [##] { $a -> $a | trim }
128 when $b -> 048 [##] { $b -> $a ; $c -> $b }
128 when !$b when $c -> 048 [##] { $c -> $b }
011 -> 022 [{@ind1}#] { $a -> $a ; $f -> $l ; $y -> $y ; $z -> $z }
071 -> 028 [{@ind1}{@ind2}] { $a -> $a ; $b -> $b ; order $a $b }
013 -> 024 [2#] { $a -> $a ; $b -> += " ({|replace('\.$', '')})" ; $d -> $c }
017 -> 024 [7#] { $a -> $a ; $2 -> $2 }
029 when $b -> 024 [7#] { $b -> $a ; -> $2 "FRnnt" ; order $a $2 }
029 when $e -> 024 [8#] { $e -> $a ; -> $q "Thèse d'exercice" ; order $a $q }
073 -> 024 [3{@ind2|table(ind024)}] { $a -> $a ; $b -> += " ({|replace('\.$', '')})" }
101 -> 041 [{@ind1|table(ind041)}#] {
  $a -> $a ; $d -> $b ; $j -> $b ; $c -> $h ; $i -> $g ; $h -> $e ; $e -> $f
  $2 -> $2
}

# ---- Content, media, carrier types ----------------------------------

181 when $c -> 336 [##] { $c -> $b ; $2 -> $2 }
182 when $c -> 337 [##] { $c -> $b ; $2 -> $2 }
182 when $a -> 337 [##] { $a -> $b ; -> $2 "isbdmedia" ; order $b $2 }
183 -> 338 [##] { $a -> $b ; $2 -> $2 }
181 when $a -> 886 [2#] { -> $2 "unimarc" ; -> $a "181" ; -> $b "" ; $a -> $a ; $b -> $b }

# ---- Description ----------------------------------------------------

200 -> 245 [{700,710,720|exists(1,0)} {$a|nonfiling}] {
  $a[1] -> $a | strip_nsb
  $a[2..] -> $b {|strip_nsb} before " ;"
  # Parallel titles begin with "= " in the Sudoc
  $d[1] -> $b {|strip_nsb|replace('^= ?', '')} before " ="
  $d[2..] -> += " = {|strip_nsb|replace('^= ?', '')}"
  $e -> $b before " :"
  $f[1] -> $c before " /"
  $f[2..] -> += " ; {}"
  $g -> += " ; {}"
  $h -> $n before "."
  $i -> $p before "," after $n before "."
  # Abes adds the period even after an abbreviation ("comp.."): not kept
  end "."
}
# A final period, unless the statement ends with "]" or "."
205 -> 250 [##] { $a -> $a | replace('([^\].])$', '$1.') }
207 -> 362 [##] { $a -> $a }
230 -> 256 [##] { $a -> $a ; end "." }
# Publication (210, older records) -> 260; manufacture in parentheses
# A final period, unless the date ends with "]", ")", "?", "-" or ".".
# A later publisher (indicator 1 = 1) is not kept.
210 when !@ind1=1 when !$e -> 260 [##] {
  $a -> $a before " ;"
  $b -> += " ({})"
  $c -> $b before " :"
  $d -> $c {|replace('([^\]?.-])$', '$1.')} before ","
}
210 when !@ind1=1 when $e -> 260 [##] {
  $a -> $a before " ;"
  $b -> += " ({})"
  $c -> $b before " :"
  $d -> $c before ","
  $e -> $e "({}{$g|exists('', ')')}"
  $g -> $f "{})" before " :"
}
214 -> 264 [#{@ind2|table(ind264)}] {
  $a -> $a before " ;"
  $c -> $b before " :"
  $d -> $c before "," after $b
  end "."
}
# Each element ends with a period, unless it ends with ")", "]", "°" or "."
215 -> 300 [##] {
  $a -> $a | replace('([^.)\]°])$', '$1.')
  $c -> $b {|replace('([^.)\]°])$', '$1.')} before " :"
  $d -> $c {|replace('([^.)\]°])$', '$1.')} before " ;"
  $e -> $e {|replace('([^.)\]°])$', '$1.')} before " +"
}
# The volume number of a subseries ($i) is not kept
225 when !$i -> 490 [{@ind1|table(ind490)}#] {
  $a -> $a | strip_nsb
  $x -> $x before ","
  $v -> $v before " ;"
}
225 when $i -> 490 [{@ind1|table(ind490)}#] {
  $a -> $a | strip_nsb
  $i -> += ". {}"
  $x -> $x before ","
}

# ---- Notes ----------------------------------------------------------

# General notes: a final period, unless the note ends with ".", ")", "]",
# "?" or "!"
300 301 302 304 305 306 307 308 312 333 -> 500 [##] { $a -> $a | replace('([^.)\]?!])$', '$1.') }
315 -> 507 [##] { $a -> $a | replace('([^.)\]?!])$', '$1.') }
320 -> 504 [##] { $a -> $a | replace('([^.)\]?!])$', '$1.') }
